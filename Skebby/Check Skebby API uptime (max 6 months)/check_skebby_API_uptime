if len(sys.argv) != 2:
    print("Missing parameter: activation_date (YYYY-MM-DD)")
    sys.exit(2)

activation_date_str = sys.argv[1]

try:
    activation_date = datetime.strptime(activation_date_str, "%Y-%m-%d")
except ValueError:
    printt("Invalid date format (use YYYY-MM-DD)")
    sys.exit(2)

today = datetime.now()
days_active = (today - activation_date).days
